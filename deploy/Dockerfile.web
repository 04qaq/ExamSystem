# 构建上下文为仓库根目录（见 docker-compose）
FROM node:22-bookworm AS fe

WORKDIR /fe
COPY exam-client/frontend/package.json exam-client/frontend/package-lock.json ./
RUN npm ci

COPY exam-client/frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=fe /fe/dist /usr/share/nginx/html

EXPOSE 80
