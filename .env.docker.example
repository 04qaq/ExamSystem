# 复制为 .env 后由 docker compose 加载：docker compose --env-file .env up -d --build

WEB_PORT=8080
SERVER_MODE=release

MYSQL_ROOT_PASSWORD=examroot
MYSQL_DATABASE=exam_system
MYSQL_USER=exam
MYSQL_PASSWORD=exampass

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE=24h
JWT_REFRESH_EXPIRE=168h
